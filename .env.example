# =====================================================================
# TEMPLATE KONFIGURASI LINGKUNGAN (12-FACTOR APP)
# Salin berkas ini ke `.env` di mesin lokal Anda:
#   cp .env.example .env
# Peringatan: JANGAN PERNAH mengisi nilai kredensial rahasia asli di sini!
# =====================================================================

# Lingkungan aplikasi: development, staging, production
APP_ENV=development
APP_PORT=8000
DEBUG=true

# Koneksi Database
DATABASE_URL=sqlite:///siakad_dev.db

# Kredensial Payment Gateway Kampus (Gunakan dummy token untuk lokal)
PAYMENT_GATEWAY_URL=https://sandbox.bank.uinam.ac.id/api/v1
PAYMENT_API_KEY=dummy_sandbox_api_key_uinam_2026

# WhatsApp Notifier API
WA_GATEWAY_URL=https://api.whatsapp-sim.local
WA_AUTH_TOKEN=dummy_wa_token_dev
